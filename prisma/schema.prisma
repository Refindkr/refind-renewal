generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  company   String?
  phone     String?
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inquiries  Inquiry[]
  answers    Answer[]
  notices    Notice[]
  cardNews   CardNews[]
  topBanners TopBanner[]
}

model Inquiry {
  id        String   @id @default(cuid())
  category  String
  subject   String
  content   String
  isPrivate Boolean  @default(false)
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  answer Answer?
}

model Answer {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inquiryId String  @unique
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
}

// 공지사항 — slug로 도메인 바로 아래 flat URL(/notice1) 접근 (SEO 유지 목적)
model Notice {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  content            String
  thumbnail          String?
  isExhibitionBanner Boolean  @default(false) // 홈페이지 히어로에 전시회 배너로 노출할지 여부
  bannerEyebrow      String? // 전시회 배너 상단 라벨문구 (선택, 예: "EXHIBITION · 전시회 안내")
  bannerSubtitle     String? // 전시회 배너로 노출될 때 표시할 소개문구 (선택)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
}

// 카드뉴스 — slug로 도메인 바로 아래 flat URL(/card1) 접근 (SEO 유지 목적)
model CardNews {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  thumbnail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
}

// 사이트 최상단 공지 배너 — 여러 개 등록 가능, isActive인 것 중 가장 최근 것 하나만 노출
model TopBanner {
  id        String   @id @default(cuid())
  message   String
  href      String? // 클릭 시 이동할 링크 (선택)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
}
